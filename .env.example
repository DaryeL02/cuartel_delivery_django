# Copien este archivo como ".env" y ajusten los valores para su organizacion.
# El archivo ".env" NO se sube a GitHub (ver .gitignore).

POSTGRES_DB=proyecto_db
POSTGRES_USER=proyecto_user
POSTGRES_PASSWORD=proyecto_pass

# Configuración SMTP para enviar enlaces de restablecimiento.
# Si EMAIL_HOST queda vacío, Django imprimirá el enlace en los logs del contenedor.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=brisadelmar2799@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=brisadelmar2799@gmail.com
FRONTEND_URL=http://localhost:3000
